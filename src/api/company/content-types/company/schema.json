{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "text"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "company_status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved",
        "Reject"
      ]
    },
    "rejection_reason": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "company"
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq",
      "mappedBy": "company"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "company"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service",
      "mappedBy": "company"
    },
    "company_content": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company-content.company-content",
      "mappedBy": "company"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "companies"
    },
    "email_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::email-log.email-log",
      "mappedBy": "company"
    },
    "inquiries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inquiry.inquiry",
      "mappedBy": "company"
    },
    "views": {
      "type": "integer"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "companies"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "companies"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "companies"
    },
    "area": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::area.area",
      "inversedBy": "companies"
    },
    "zip_code": {
      "type": "string"
    },
    "lat": {
      "type": "decimal"
    },
    "lng": {
      "type": "decimal"
    },
    "tags": {
      "type": "text"
    },
    "years_in_business": {
      "type": "integer"
    },
    "iata": {
      "type": "string"
    },
    "buisness_hours": {
      "type": "json"
    },
    "social_links": {
      "type": "json"
    },
    "rating_count": {
      "type": "integer"
    },
    "long_desc": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "contact_person_name": {
      "type": "string"
    },
    "contact_person_email": {
      "type": "email"
    },
    "contact_person_designation": {
      "type": "enumeration",
      "enum": [
        "Owner",
        " Manager",
        "CEO",
        "Marketer"
      ]
    },
    "author_review": {
      "type": "text"
    },
    "allow_email": {
      "type": "boolean",
      "default": true
    },
    "company_locations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::company-location.company-location",
      "mappedBy": "company"
    }
  }
}
